{
  "name": "memloom",
  "version": "0.2.1",
  "private": true,
  "description": "Local-first long-term experience memory for coding agents (DSH & Antigravity): durable scoped storage, BM25 retrieval, dreaming & human review.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.5"
  },
  "keywords": [
    "memloom",
    "memory",
    "long-term-memory",
    "agent",
    "dsh",
    "antigravity",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiaMingWang-CN/memloom.git"
  },
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/core/**/*.js",
    "dist/core/**/*.d.ts",
    "dist/host/**/*.js",
    "dist/host/**/*.d.ts",
    "dist/shared/**/*.js",
    "dist/shared/**/*.d.ts",
    "dist/remote-spec.js",
    "dist/remote-spec.d.ts",
    "dist/client.js",
    "cordis.patch.yml",
    "locale",
    "docs/DETAIL.md",
    "docs/architecture.md",
    "docs/memory-model.md",
    "docs/dreaming.md",
    "docs/configuration.md",
    "docs/security.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:agy": "node scripts/build-agy.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "pack:check": "node scripts/pack-check.mjs",
    "pack:agy:check": "node scripts/pack-agy-check.mjs",
    "pack:desktop:check": "node scripts/pack-desktop-check.mjs",
    "prepack": "pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
