{
  "name": "memloom-desktop-packager",
  "version": "0.1.3",
  "private": true,
  "description": "Isolated Electron & electron-builder packaging workspace for Memloom Desktop (0.x development preview).",
  "scripts": {
    "pack:win": "electron-builder --config ./electron-builder.yml --win nsis --x64",
    "pack:win:dir": "electron-builder --config ./electron-builder.yml --win --x64 --dir",
    "pack:win:from-dir": "electron-builder --config ./electron-builder.yml --win nsis --x64 --prepackaged ../dist/desktop-release/win-unpacked"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  }
}
